@model List<prac6.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Product Catalog</title>
</head>
<body>
    <h2>Product Catalog</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Details</th>
        </tr>

        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.Price</td>
                <td>@p.Category</td>
                <td>
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@p.Id">View Details</a>
                </td>
            </tr>
        }
    </table>
</body>
</html>
